# =====================================================================
# JARVIS AI - Environment Configuration Template
# Copy this file to .env and configure your settings
# =====================================================================

# --- Google Gemini Configuration (Primary Provider) ---
# Get an API key at https://aistudio.google.com/
GEMINI_API_KEY=

# Model selection:
# Recommended: gemini-2.5-flash or gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash

# Enable Google Search Grounding for live web information (true/false)
GEMINI_SEARCH_GROUNDING=true

# --- Default AI Provider ---
# Options: gemini | openai | ollama | local
DEFAULT_AI_PROVIDER=gemini

# --- OpenAI / Compatible Providers (Groq, DeepSeek, OpenRouter) ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- Local Ollama Configuration ---
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# --- Voice & Audio Configuration ---
# Microphone index override (leave blank for automatic best detection)
# JARVIS_MIC_INDEX=
